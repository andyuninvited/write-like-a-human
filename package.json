{
  "name": "write-like-a-human",
  "version": "0.1.0",
  "description": "Make AI write in your voice, and get better from your edits. Claude Code skill plus a small CLI.",
  "license": "MIT",
  "author": "Andy Rosic",
  "type": "module",
  "bin": {
    "write-like-a-human": "dist/cli.js",
    "wlah": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "node dist/cli.js eval --voice examples/voice --cases evals/cases",
    "lint:prose": "node dist/cli.js lint README.md CLAUDE.md evals/README.md --config examples/voice/rules.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
